# ==============================================================================
# AuraWorks Industrial Intelligence OS - Backend Environment Configuration
# ==============================================================================

# --- APPLICATION SETTINGS ---
PROJECT_NAME="AuraWorks Industrial Intelligence OS"
VERSION=3.2.1
API_V1_STR=/api/v1
ENVIRONMENT=production # production | staging | development
API_DOMAIN=api.auraworks.co.za

# --- SECURITY & AUTHENTICATION ---
# High-entropy random secret for admin API access and internal health/janitor jobs
ADMIN_API_KEY=your-production-admin-api-key-here-min-32-chars

# Internal cryptographic secret key
SECRET_KEY=your-production-backend-secret-key-min-32-chars

# Shared secret with Better Auth (dashboard/frontend) for JWT and session cookie validation
BETTER_AUTH_SECRET=your-shared-better-auth-secret-min-32-chars

# Token lifetime (11520 minutes = 8 days for long-cycle industrial procurement)
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# Wildcard root cookie domain (set to .auraworks.co.za in production for cross-subdomain sessions)
COOKIE_DOMAIN=.auraworks.co.za

# Optional OAuth credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URI=https://api.auraworks.co.za/api/v1/auth/google/callback

# --- DATABASE & CACHING ---
# Primary PostgreSQL Database (use postgresql+asyncpg:// for async FastAPI engine)
DATABASE_URL=postgresql+asyncpg://user:password@postgres-host:5432/dbname?ssl=require

# Redis Connection (Rate limiting and forensic visitor state)
REDIS_URL=redis://default:password@redis-host:6379

# --- PAYMENT INTEGRATIONS ---
# iKhokha Gateway
IKHOKHA_API_URL=https://api.ikhokha.com
IKHOKHA_CLIENT_ID=
IKHOKHA_CLIENT_SECRET=
IKHOKHA_WEBHOOK_SECRET=

# PayGenius Fallback Gateway
PAYGENIUS_WEBHOOK_SECRET=

# --- VISITOR ENRICHMENT & FORENSICS ---
# IPInfo.io (Reverse IP to ASN & Company resolution)
IPINFO_TOKEN=

# Apollo.io (Executive contact enrichment & B2B persona matching)
APOLLO_API_KEY=

# DeepSeek AI (Forensic visitor intent classification)
DEEPSEEK_API_KEY=

# --- DATA SINKS & WORKSPACES ---
# Airtable Leads Sink
AIRTABLE_BASE_ID=
AIRTABLE_API_KEY=
AIRTABLE_TABLE_NAME=Forensic_Leads

# Notion CRM Workspace
NOTION_DATABASE_ID=
NOTION_TOKEN=

# --- NOTIFICATION DISPATCH (SLACK) ---
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
SLACK_VISIT_WEBHOOK_URL=https://hooks.slack.com/services/...
SLACK_COMPLIANCE_WEBHOOK_URL=https://hooks.slack.com/services/...
SLACK_SUPPORT_WEBHOOK_URL=https://hooks.slack.com/services/...

# --- EMAIL ENGINE (RESEND) ---
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=AuraWorks <onboarding@auraworks.co.za>
RESEND_WEBHOOK_SECRET=

# Calendly Integration
CALENDLY_LINK=https://calendly.com/auraworks/demo
CALENDLY_WEBHOOK_SECRET=

# --- MEDIA ASSETS (IMAGEKIT) ---
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/auraworks
