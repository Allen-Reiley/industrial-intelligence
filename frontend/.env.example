# Frontend Environment Configuration Example
NEXT_PUBLIC_API_URL=https://api.auraworks.co.za
BETTER_AUTH_SECRET=your-better-auth-secret-key-at-least-32-chars
BETTER_AUTH_URL=https://www.auraworks.co.za
COOKIE_DOMAIN=.auraworks.co.za
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Optional Social OAuth Providers
# Leave blank or omit if not configured to suppress Better Auth warnings
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Public Environment Identifiers
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
