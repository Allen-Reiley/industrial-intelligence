# ==============================================================================
# AuraHQ Dashboard Environment Configuration (dash.auraworks.co.za)
# ==============================================================================

# --- FASTAPI BACKEND API ---
# Local: http://localhost:8000 | Production: https://api.auraworks.co.za
NEXT_PUBLIC_API_URL=https://api.auraworks.co.za

# --- BETTER AUTH CONFIGURATION ---
# Base URL of the dashboard app (must match the canonical origin)
# Local: http://localhost:3000 | Production: https://dash.auraworks.co.za
BETTER_AUTH_URL=https://dash.auraworks.co.za

# High-entropy shared secret key (must match backend BETTER_AUTH_SECRET)
BETTER_AUTH_SECRET=your-shared-better-auth-secret-min-32-chars

# Shared subdomain cookie domain (allows shared authentication across *.auraworks.co.za)
COOKIE_DOMAIN=.auraworks.co.za

# --- DATABASE CONNECTION ---
# Direct PostgreSQL connection string for Better Auth session and user verification
# (Format: postgresql://user:password@host:5432/dbname?sslmode=require)
DATABASE_URL=postgresql://user:password@postgres-host:5432/dbname?sslmode=require

# --- POSTHOG ANALYTICS ---
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_AkVXnxZvKweeKXbnpriK4EbGYvP2A4dD6dU7cJvxTuKj
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- IMAGEKIT (AVATAR & MEDIA UPLOADS) ---
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/auraworks

# --- OPTIONAL SOCIAL AUTHENTICATION ---
# Leave empty if using email/password authentication only
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
