                </div>
                <Badge size="sm" color="primary">Active Pipeline</Badge>
              </div>
            </div>

            {/* Metric 2 */}
            <div className="rounded-2xl border border-gray-200 bg-white p-5 md:p-6 dark:border-gray-800 dark:bg-white/3">
