                    document.cookie = `aura_consent=true; expires=${exp.toUTCString()}; path=/; SameSite=Lax; Secure`;
                    localStorage.setItem('aura_consent_given', 'true');

                    window.dispatchEvent(new CustomEvent('aura_warm_lead', {
