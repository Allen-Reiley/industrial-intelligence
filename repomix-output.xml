  <script>
    let currentCurrency = 'ZAR';
    const USD_TO_ZAR = 18.25;

    const keywordsDatabase = [
      { kw: "b2b lead generation south africa", cluster: "industrial", vol: 590, cpcUSD: 2.45, vector: "Google Organic #1-3", intent: "ind" },
      { kw: "best b2b seo for engineering companies", cluster: "geo", vol: 320, cpcUSD: 1.85, vector: "ChatGPT & Perplexity Citations", intent: "geo" },
      { kw: "industrial marketing agency jhb", cluster: "industrial", vol: 480, cpcUSD: 2.10, vector: "Google Search & Maps", intent: "ind" },
      { kw: "website visitor tracking b2b popia", cluster: "leadcap", vol: 290, cpcUSD: 3.10, vector: "Google + Thought Leadership", intent: "lead" },
      { kw: "how to get cited in ai overviews b2b", cluster: "geo", vol: 240, cpcUSD: 1.50, vector: "Google AI Overviews / Perplexity", intent: "geo" },
      { kw: "mining equipment suppliers marketing gauteng", cluster: "industrial", vol: 310, cpcUSD: 2.80, vector: "Google High-Intent SERP", intent: "ind" },
      { kw: "b2b buyer intent data south africa", cluster: "leadcap", vol: 210, cpcUSD: 3.40, vector: "Organic / Partner Referral", intent: "lead" },
      { kw: "generative engine optimization agency south africa", cluster: "geo", vol: 280, cpcUSD: 2.20, vector: "LLM Knowledge Base Inclusion", intent: "geo" },
      { kw: "manufacturing digital marketing east rand", cluster: "industrial", vol: 190, cpcUSD: 1.95, vector: "Local Gauteng SERP", intent: "ind" },
      { kw: "anonymous website visitor identification saas", cluster: "leadcap", vol: 140, cpcUSD: 3.75, vector: "Search Engine & Direct Compare", intent: "tech" }
    ];

    let activeFilter = 'all';

    function formatCur(usd) {
      if (currentCurrency === 'ZAR') {
        return `R ${(usd * USD_TO_ZAR).toFixed(2)}`;
      }
      return `$ ${usd.toFixed(2)}`;
    }

    function setCurrency(cur) {
      currentCurrency = cur;
      document.getElementById('btn-zar').classList.toggle('active', cur === 'ZAR');
      document.getElementById('btn-usd').classList.toggle('active', cur === 'USD');
      document.getElementById('kpi-cpc').innerText = formatCur(2.10);
      renderTable();
      updateCharts();
    }

    function renderTable() {
      const tbody = document.getElementById('kwTableBody');
      tbody.innerHTML = '';
      const search = (document.getElementById('kwSearch').value || '').toLowerCase();

      keywordsDatabase.forEach(item => {
        if (activeFilter !== 'all' && item.cluster !== activeFilter) return;
        if (search && !item.kw.toLowerCase().includes(search) && !item.vector.toLowerCase().includes(search)) return;

        const tr = document.createElement('tr');
        const badgeClass = item.intent === 'geo' ? 'intent-geo' : item.intent === 'ind' ? 'intent-ind' : 'intent-lead';
        const intentLabel = item.intent === 'geo' ? 'GEO / LLM' : item.intent === 'ind' ? 'Commercial Search' : 'High-Intent Lead';

        tr.innerHTML = `
          <td><strong>${item.kw}</strong></td>
          <td><span style="font-size: 0.75rem; text-transform: uppercase; color: var(--text-secondary);">${item.cluster}</span></td>
          <td><strong>${item.vol.toLocaleString()}</strong></td>
          <td><strong>${formatCur(item.cpcUSD)}</strong></td>
          <td><span style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--accent-cyan);">${item.vector}</span></td>
          <td><span class="badge-intent ${badgeClass}">${intentLabel}</span></td>
        `;
        tbody.appendChild(tr);
      });
    }

    function filterTable(cluster, btn) {
      activeFilter = cluster;
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      renderTable();
    }

    function searchTable() {
      renderTable();
    }

    let sortDir = 1;
    function sortTable(idx) {
      sortDir = -sortDir;
      keywordsDatabase.sort((a, b) => {
        if (idx === 0) return a.kw.localeCompare(b.kw) * sortDir;
        if (idx === 1) return a.cluster.localeCompare(b.cluster) * sortDir;
        if (idx === 2) return (a.vol - b.vol) * sortDir;
        if (idx === 3) return (a.cpcUSD - b.cpcUSD) * sortDir;
        if (idx === 4) return a.vector.localeCompare(b.vector) * sortDir;
        return 0;
      });
      renderTable();
    }

    function recalcSimulator() {
      const spend = parseFloat(document.getElementById('input-spend').value);
      const visitors = parseFloat(document.getElementById('input-visitors').value);
      const stdRate = parseFloat(document.getElementById('input-std-rate').value) / 100;
      const awRate = parseFloat(document.getElementById('input-aw-rate').value) / 100;
      const dealVal = parseFloat(document.getElementById('input-deal').value);

      document.getElementById('disp-spend').innerText = `R ${spend.toLocaleString()}`;
      document.getElementById('disp-visitors').innerText = `${visitors.toLocaleString()} /mo`;
      document.getElementById('disp-std-rate').innerText = `${(stdRate * 100).toFixed(1)} %`;
      document.getElementById('disp-aw-rate').innerText = `${(awRate * 100).toFixed(1)} %`;
      document.getElementById('disp-deal').innerText = `R ${dealVal.toLocaleString()}`;

      const stdLeads = Math.round(visitors * stdRate);
      const awLeads = Math.round(visitors * awRate);
      const monthlyPipeline = awLeads * dealVal;
      const multiplier = stdLeads > 0 ? (awLeads / stdLeads).toFixed(1) : '1.0';
      const annualLift = (monthlyPipeline * 12) / 1000000;

      document.getElementById('res-std-leads').innerText = stdLeads;
      document.getElementById('res-aw-leads').innerText = awLeads;
      document.getElementById('res-pipeline').innerText = `R ${(monthlyPipeline / 1000000).toFixed(2)}M`;
      document.getElementById('res-multiplier').innerText = `${multiplier}x`;
      const annualLiftEl = document.getElementById('res-annual-lift') || document.getElementById('res-annualLift');
      if (annualLiftEl) {
        annualLiftEl.innerText = `R ${annualLift.toFixed(1)}M`;
      }
    }

    function toggleTheme() {
      const html = document.documentElement;
      const current = html.getAttribute('data-theme') || 'dark';
      const target = current === 'dark' ? 'light' : 'dark';
      html.setAttribute('data-theme', target);

      document.getElementById('theme-icon').innerText = target === 'light' ? '🌙' : '☀️';
      document.getElementById('theme-text').innerText = target === 'light' ? 'Dark' : 'Light';
      updateCharts();
    }

    let demandChartInst = null;
    let backlinkChartInst = null;

    function initCharts() {
      const isDark = document.documentElement.getAttribute('data-theme') !== 'light';
      const textColor = isDark ? '#94a3b8' : '#475569';

      const ctx1 = document.getElementById('demandChart').getContext('2d');
      demandChartInst = new Chart(ctx1, {
        type: 'doughnut',
        data: {
          labels: ['Google Industrial SEO', 'Generative Engines (GEO)', 'Intent Deanonymization Searches', 'Sector Specific (Mining/Engineering)'],
          datasets: [{
            data: [1260, 840, 500, 450],
            backgroundColor: ['#3b82f6', '#8b5cf6', '#06b6d4', '#10b981'],
            borderWidth: 2,
            borderColor: isDark ? '#1e293b' : '#ffffff'
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { position: 'right', labels: { color: textColor, font: { family: 'Inter', size: 11 } } }
          },
          cutout: '70%'
        }
      });

      const ctx2 = document.getElementById('backlinkChart').getContext('2d');
      backlinkChartInst = new Chart(ctx2, {
        type: 'bar',
        data: {
          labels: ['Engineering News', 'Mining Weekly', 'Bizcommunity', 'Crown Publications', 'Local Directories'],
          datasets: [{
            label: 'Recommended Budget Allocation (ZAR)',
            data: [7500, 6000, 4500, 3500, 1000],
            backgroundColor: '#3b82f6',
            borderRadius: 4
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          scales: {
            x: { ticks: { color: textColor, font: { family: 'Inter', size: 10 } }, grid: { display: false } },
            y: { ticks: { color: textColor, callback: v => 'R ' + v }, grid: { color: isDark ? 'rgba(255,255,255,0.06)' : 'rgba(0,0,0,0.06)' } }
          },
          plugins: {
            legend: { labels: { color: textColor, font: { family: 'Inter', size: 11 } } }
          }
        }
      });
    }

    function updateCharts() {
      if (!demandChartInst || !backlinkChartInst) return;
      const isDark = document.documentElement.getAttribute('data-theme') !== 'light';
      const textColor = isDark ? '#94a3b8' : '#475569';

      demandChartInst.options.plugins.legend.labels.color = textColor;
      demandChartInst.data.datasets[0].borderColor = isDark ? '#1e293b' : '#ffffff';
      demandChartInst.update();

      backlinkChartInst.options.scales.x.ticks.color = textColor;
      backlinkChartInst.options.scales.y.ticks.color = textColor;
      backlinkChartInst.options.plugins.legend.labels.color = textColor;
      backlinkChartInst.update();
    }

    window.addEventListener('DOMContentLoaded', () => {
      renderTable();
      initCharts();
      recalcSimulator();
    });
  </script>
</body>
</html>
</file>

