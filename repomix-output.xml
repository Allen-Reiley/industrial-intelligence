    `process.env.NEXT_PUBLIC_API_URL || "http://localhost:8000"`
  - `analytics/page.tsx`:
    `process.env.NEXT_PUBLIC_API_URL || "https://dynamic-flow-production-a5d6.up.railway.app"`
