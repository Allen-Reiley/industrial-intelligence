        {unreadCount > 0 && (
          <span className="absolute top-0.5 right-0 z-10 h-2.5 w-2.5 rounded-full bg-brand-500">
            <span className="absolute inline-flex h-full w-full animate-ping rounded-full bg-brand-400 opacity-75" />
